# Plain HTTP; TLS is terminated by the external reverse proxy.
{
	auto_https off
	servers {
		# Read the visitor address from X-Forwarded-For only behind
		# these proxies, right to left, so a client cannot forge it.
		trusted_proxies static {$TRUSTED_PROXY:private_ranges}
		trusted_proxies_strict
	}
}

# The API trusts this header (uvicorn --proxy-headers): one address.
(to_api) {
	reverse_proxy api:8000 {
		header_up X-Forwarded-For {client_ip}
	}
}

:80 {
	root * /srv/site
	encode gzip zstd

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; manifest-src 'self'; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# API and photos are served by the FastAPI container.
	handle /api/* {
		request_body {
			max_size 20MB
		}
		import to_api
	}
	handle /media/* {
		import to_api
	}
	# Public photos of shared recipes; the bare /share (share target)
	# stays the app shell below.
	@share_photos path /share/*/photos/*
	handle @share_photos {
		import to_api
	}

	# Static files with SPA fallback for non-file routes.
	handle {
		# Revalidate code on every load so updates show at once.
		@shell path / /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"
		@code path *.js *.css
		header @code Cache-Control "no-cache"

		@icon path /icons/*
		header @icon Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
